# A shared Postgres database. Use TLS for a hosted database.
DATABASE_URL=postgres://demo@127.0.0.1:5432/fixture_events_demo
# Single-operator HTTP Basic authentication. Use a random password of 32+ characters.
DEMO_USER=operator
DEMO_PASSWORD=
APP_ORIGIN=http://localhost:3000

# Configure these only after creating/linking the Vercel Connect connector.
CONNECTOR_ID=
FIXTURE_MCP_URL=
DEMO_SUBJECT_ID=
FIXTURE_SCOPES=crm:read tasks:read events:read events:manage

# Trusted deployment identity. Vercel supplies the project/org/target environment.
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
VERCEL_TARGET_ENV=production
CONNECT_OIDC_ISSUER=
CONNECT_OIDC_AUDIENCE=
# Only for a stable Vercel Custom environment (not Production).
CONNECT_CUSTOM_ENVIRONMENT_ID=
